rules_version = '2';

// 熵與焙 Firestore 安全規則
// 用法：Firebase 主控台 → Firestore Database → 規則 → 把這整份內容貼上 → 發布
// ⚠ 在主控台貼上後，再把下面兩個「請換成…」改成兩位管理員登入後台用的信箱
//   （要跟 Firebase 主控台 → Authentication → 使用者 裡的信箱一模一樣）
// ⚠ 這個 GitHub 專案是公開的，真正的信箱只填在 Firebase 主控台，不要改進這個檔案
service cloud.firestore {
  match /databases/{database}/documents {

    // 只有名單內的信箱能修改資料；別人就算自己註冊帳號也改不了
    // 要增減管理員就在清單裡加減，信箱之間用逗號隔開
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['請換成第一位管理員信箱', '請換成第二位管理員信箱'];
    }

    // 寫入的商品至少要有商品名稱，狀態只能是「上架」或「下架」
    function isValidProduct(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.status in ['上架', '下架'];
    }

    // 客人送出的訂單／儲值申請：檢查欄位與長度，避免被塞入奇怪或過大的資料
    function isValidNewOrder(d) {
      return d.status == '待付款'
        && d.created_at == request.time
        && d.order_no is string && d.order_no.size() <= 20
        && d.customer is map
        && d.customer.keys().hasOnly(['name', 'phone', 'store', 'address'])
        && d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 30
        && d.customer.phone is string && d.customer.phone.size() >= 9 && d.customer.phone.size() <= 20
        && d.note is string && d.note.size() <= 200
        && d.amounts is map && d.amounts.total is number && d.amounts.total >= 0
        && d.payment_method in ['transfer', 'stored_value']
        && isOwnedByRequester(d)
        && (isValidShopOrder(d) || isValidTopup(d));
    }

    // 用 LINE 登入的客人，訂單上記的身分必須是本人（不能幫別人下單或冒用別人的身分）
    function isOwnedByRequester(d) {
      return !('customer_uid' in d) || (request.auth != null && d.customer_uid == request.auth.uid);
    }

    function isValidShopOrder(d) {
      return d.type == 'order'
        && d.keys().hasOnly(['type', 'order_no', 'status', 'payment_method', 'delivery', 'delivery_label',
                             'customer', 'note', 'items', 'amounts', 'created_at', 'customer_uid'])
        && d.delivery in ['pickup', 'cvs', 'home']
        && d.items is list && d.items.size() > 0 && d.items.size() <= 30;
    }

    function isValidTopup(d) {
      return d.type == 'topup'
        && d.keys().hasOnly(['type', 'order_no', 'status', 'payment_method', 'customer', 'note',
                             'topup', 'amounts', 'created_at', 'customer_uid'])
        && d.payment_method == 'transfer'
        && d.topup is map && d.topup.plan_amount is number && d.topup.plan_amount > 0;
    }

    match /products/{productId} {
      // 客人只能讀到上架中的商品；下架的只有管理員看得到
      allow read: if resource.data.status == '上架' || isAdmin();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // 商店設定（轉帳帳號、運費、耗材費）：前台要顯示，所以大家都能讀；只有管理員能改
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 客人回報匯款：只能是自己的「待付款、銀行轉帳」訂單，而且只能填帳號後五碼與回報時間
    function isPaymentReport() {
      return request.auth != null
        && resource.data.customer_uid == request.auth.uid
        && resource.data.status == '待付款'
        && resource.data.payment_method == 'transfer'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment_last5', 'payment_reported_at'])
        && request.resource.data.payment_last5 is string
        && request.resource.data.payment_last5.matches('^[0-9]{5}$')
        && request.resource.data.payment_reported_at == request.time;
    }

    // 訂單：客人可以「新增」；用 LINE 登入的客人只看得到自己的訂單，只能回報匯款；管理員可以查看與處理
    match /orders/{orderId} {
      allow create: if isValidNewOrder(request.resource.data);
      allow read: if isAdmin()
        || (request.auth != null && resource.data.customer_uid == request.auth.uid);
      allow update: if isAdmin() || isPaymentReport();
      allow delete: if isAdmin();
    }

    // 儲值會員：只有管理員能修改；綁定 LINE 的客人可以查看自己的餘額
    // 詳細交易紀錄（含經手管理員）只有管理員看得到
    match /members/{memberId} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid in resource.data.line_uids);
      allow write: if isAdmin();

      match /transactions/{transactionId} {
        allow read, write: if isAdmin();
      }
    }

    // 沒有寫到的其他資料，一律不開放讀寫
  }
}
